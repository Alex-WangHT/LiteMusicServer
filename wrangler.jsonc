{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liteplayer",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-01-01",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "liteplayer",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "liteplayer-audio" }],
  "vars": { "ALLOWED_ORIGIN": "*" }
}
