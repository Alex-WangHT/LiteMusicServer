WORKER_URL=http://127.0.0.1:8787
ADMIN_TOKEN=replace-with-a-long-random-admin-token
DOWNLOADER_TOKEN=replace-with-a-different-long-random-token
# Windows: .tools/yt-dlp.exe; Linux: yt-dlp
YTDLP_PATH=.tools/yt-dlp.exe
# Optional override; defaults to platform-specific ffmpeg-static installed by npm
# FFMPEG_PATH=C:/tools/ffmpeg.exe
POLL_INTERVAL_MS=5000
# Set after npm run user:create; used by video/browser tests only
# USER_KEY_FILE=.user-<id>.json
WEB_URL=http://127.0.0.1:5173
# Optional HTTP/SOCKS proxy used only by yt-dlp (not Worker API requests)
# YTDLP_PROXY=http://127.0.0.1:7890
# Optional Netscape cookies file explicitly exported by you; never auto-read browser cookies
# YTDLP_COOKIES_FILE=C:/private/bilibili-cookies.txt
